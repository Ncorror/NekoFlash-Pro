<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Универсальный attach-фильтр, перенесённый из Legacy.

        ADB и Fastboot используют vendor-specific интерфейсы (class 0xFF).
        Android сопоставляет class-фильтр не только с дескриптором устройства,
        но и с дескрипторами интерфейсов, поэтому один wildcard по class="255"
        охватывает:
          - канонический ADB       0xFF / 0x42 / 0x01;
          - канонический Fastboot  0xFF / 0x42 / 0x03;
          - OEM Fastboot с нестандартными subclass и protocol;
          - новые vendorId/productId без правки списка производителей.

        Список конкретных производителей здесь был бы ровно тем запретом,
        который запрещает продуктовый устав: устройство отсеивалось бы за то,
        что его нет в нашем списке, а не за то, что оно отказало.

        Фильтр только доставляет attach intent. Протокол он не определяет:
        классификация живёт в UsbInterfaceClassifier, а подтверждение, что peer
        действительно говорит по выбранному протоколу, даёт handshake.
    -->
    <usb-device class="255" />
</resources>
